{
  "name": "dsh-git4idea",
  "version": "0.22.0",
  "description": "DSH plugin: an IDE-style Git tool window as a native panel — branch tree, commit graph, changes and commit details. | DSH 插件:IDE 风格 Git 工具窗口,以原生面板挂载——分支树 / 提交图谱 / 变更与提交 / 提交详情。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guojinpeng/dsh-git4idea.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./src/utils/i18n.js": "./src/utils/i18n.js",
    "./src/utils/build-client.js": "./src/utils/build-client.js"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.6-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "icon.svg",
    "locale",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/smoke.mjs tests/api.test.mjs tests/graph.test.mjs tests/repos.test.mjs",
    "build:client": "node src/utils/build-client.js",
    "build:check": "node src/utils/build-client.js --check",
    "i18n": "node src/utils/i18n.js sync",
    "i18n:check": "node src/utils/i18n.js check",
    "version": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('dsh.plugin.json','utf8'));const v=JSON.parse(fs.readFileSync('package.json','utf8')).version;m.version=v;fs.writeFileSync('dsh.plugin.json',JSON.stringify(m,null,2)+'\\n')\" && git add dsh.plugin.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "git",
    "git-gui",
    "source-control",
    "sidebar",
    "commit-graph"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "homepage": "https://github.com/guojinpeng/dsh-git4idea",
  "bugs": {
    "url": "https://github.com/guojinpeng/dsh-git4idea/issues"
  },
  "icon": "./icon.svg"
}
